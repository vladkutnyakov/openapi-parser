{
  "openapi": "3.0.3",
  "info": { "title": "User Service API", "version": "1.2.0" },
  "paths": {
    "/users": {
      "get": {
        "operationId": "getUsers",
        "summary": "Список пользователей",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "format": "int32", "default": 20 } },
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/UserStatus" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PageDtoUserResponseDto" } }
            }
          }
        }
      },
      "post": {
        "operationId": "createUser",
        "summary": "Создание пользователя",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UserCreateDto" } }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserResponseDto" } }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorDto" } }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "getUserById",
        "summary": "Пользователь по id",
        "parameters": [
          { "name": "includeRoles", "in": "query", "schema": { "type": "boolean" }, "description": "Подтянуть роли" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserResponseDto" } }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorDto" } }
            }
          }
        }
      },
      "put": {
        "operationId": "updateUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UserResponseDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UserResponseDto" } }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteUser",
        "responses": {
          "204": { "description": "No Content" }
        }
      }
    },
    "/admins/{id}": {
      "get": {
        "operationId": "getAdminById",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserDto" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserStatus": {
        "type": "string",
        "description": "Статус пользователя",
        "enum": ["ACTIVE", "BLOCKED", "DELETED"]
      },
      "RoleDto": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "UserResponseDto": {
        "type": "object",
        "required": ["id", "name", "status", "roles"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "email": { "type": "string", "nullable": true },
          "status": { "$ref": "#/components/schemas/UserStatus" },
          "createdAt": { "type": "string", "format": "date-time" },
          "roles": { "type": "array", "items": { "$ref": "#/components/schemas/RoleDto" } },
          "manager": {
            "description": "Руководитель",
            "nullable": true,
            "allOf": [{ "$ref": "#/components/schemas/UserResponseDto" }]
          }
        }
      },
      "UserCreateDto": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "roleCodes": { "type": "array", "items": { "type": "string" } }
        }
      },
      "AdminUserDto": {
        "allOf": [
          { "$ref": "#/components/schemas/UserResponseDto" },
          {
            "type": "object",
            "required": ["permissions"],
            "properties": {
              "permissions": { "type": "array", "items": { "type": "string" } }
            }
          }
        ]
      },
      "ErrorDto": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" },
          "details": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "PageDtoUserResponseDto": {
        "type": "object",
        "required": ["content", "totalElements", "totalPages"],
        "properties": {
          "content": { "type": "array", "items": { "$ref": "#/components/schemas/UserResponseDto" } },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" }
        }
      }
    }
  }
}
