{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM здесь намеренно нет: это машинная гарантия, что в чистую логику
    // не просочится браузерный API (localStorage, document и прочее).
    // ES2021 — из-за String.replaceAll в resolver.ts: раньше он проходил
    // проверку только потому, что его типы подтягивались из lib DOM
    "lib": ["ES2021"],
    "types": ["node"]
  },
  "include": ["src", "tests"]
}
